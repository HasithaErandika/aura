{
  "name": "aura-cli",
  "version": "0.1.0",
  "private": true,
  "description": "The `aura` command - AURA's developer CLI: Tasks, worktrees, the Coding Council, approvals, and commits as yourself.",
  "type": "module",
  "bin": {
    "aura": "dist/index.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aura/client": "workspace:*",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
