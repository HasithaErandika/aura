PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
WEB_ORIGIN=http://localhost:5173
# Reverse proxy hops in front of the API (0 when reached directly)
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=256kb

# Supabase project settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Service role ("secret") key. Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: JWT secret (Project Settings -> API). When set, access tokens are verified
# locally instead of calling Supabase Auth on every cache miss.
SUPABASE_JWT_SECRET=
SESSION_CACHE_TTL_MS=30000

# apps/agent-runtime (Mastra server). The API is the only thing that calls it.
MASTRA_RUNTIME_URL=http://localhost:4111
MASTRA_RUNTIME_TIMEOUT_MS=15000
# Optional bearer token if the runtime is deployed behind auth
MASTRA_RUNTIME_TOKEN=
# Hard ceiling on one agent turn (ms)
RUN_TURN_TIMEOUT_MS=600000

# Hours a pending human gate stays open before it expires. It is never auto-approved.
APPROVAL_SLA_HOURS=72

# Direct, read-only Jira Cloud REST access for browsing Epics/Stories/Tasks in the UI (same
# credentials as apps/agent-runtime's JIRA_URL/JIRA_USERNAME/JIRA_API_TOKEN/JIRA_PROJECT_KEY -
# an Atlassian API token, not your account password). The API reads Jira directly; it never
# asks the runtime or an agent to do it.
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_TIMEOUT_MS=10000

# Rate limits per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_IP=600
RATE_LIMIT_PER_USER=300
RATE_LIMIT_AGENT_TURNS_PER_USER=30
