# --- Server ---------------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# local (one developer's machine) or server (shared deployment). Same value as
# apps/agent-runtime/.env. server requires MASTRA_RUNTIME_TOKEN and DATABASE_URL.
AURA_MODE=local
LOG_LEVEL=info
# Allowed browser origins, comma-separated.
WEB_ORIGIN=http://localhost:5173
# Reverse proxy hops in front of the API (0 when reached directly).
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=256kb

# --- Supabase (Project Settings -> API) -----------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Service role ("secret") key. Server-only, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. When set, access tokens are verified locally instead of calling Supabase Auth.
SUPABASE_JWT_SECRET=
SESSION_CACHE_TTL_MS=30000

# --- Agent runtime (the API is the only caller) ---------------------------------------------------
MASTRA_RUNTIME_URL=http://localhost:4111
MASTRA_RUNTIME_TIMEOUT_MS=15000
# Shared secret with apps/agent-runtime: same value in both .env files, 32+ random characters
# (`make secret`). Required when AURA_MODE=server. Leave empty locally to keep Mastra Studio usable.
MASTRA_RUNTIME_TOKEN=
# Hard ceiling on one agent turn (ms). Fallback only: Admin -> Settings -> Limits overrides it.
RUN_TURN_TIMEOUT_MS=600000

# --- Turn queue -----------------------------------------------------------------------------------
# Postgres for the turn queue (pg-boss, schema "pgboss"). Supabase direct connection string
# (session mode, port 5432). Required when AURA_MODE=server. Empty = turns run in-process.
DATABASE_URL=
# Agent turns running at once on this process, and per user across all processes.
TURN_CONCURRENCY=4
TURN_CONCURRENCY_PER_USER=2

# --- Governance -----------------------------------------------------------------------------------
# Hours a pending gate stays open before it expires (never auto-approved).
# Fallback only: Admin -> Settings -> Governance overrides it, globally or per project.
APPROVAL_SLA_HOURS=72
# Audience of the GitHub Actions OIDC token sent with a CI report (POST /ci/report). Must match
# the `audience` in the project's aura-ci.yml. No secret needed.
AURA_CI_AUDIENCE=aura

# --- Jira (read-only, for browsing work items in the UI) ------------------------------------------
# Same credentials as apps/agent-runtime. Atlassian API token, not your account password.
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_TIMEOUT_MS=10000

# --- Rate limits (per window) ---------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_IP=600
RATE_LIMIT_PER_USER=300
RATE_LIMIT_AGENT_TURNS_PER_USER=30
