# --- Mode -----------------------------------------------------------------------------------------
# local (one developer's machine) or server (shared deployment). Same value as apps/api/.env.
# server refuses to start unless MASTRA_RUNTIME_TOKEN and DATABASE_URL are set.
AURA_MODE=local

# Shared secret with apps/api: same value in both .env files, 32+ random characters (`make secret`).
# When set, only the API can run agents or resume gates. Required when AURA_MODE=server.
# Leave empty locally to keep Mastra Studio usable (it can't send the token).
MASTRA_RUNTIME_TOKEN=

# --- Models ---------------------------------------------------------------------------------------
# Every agent tries Groq first (https://console.groq.com/keys) and falls back to Gemini
# (https://aistudio.google.com, no billing needed) on errors or rate limits. See config/models.ts.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Model policy (Admin → Settings → Governance → Data class). Comma-separated provider ids as in
# model strings (e.g. anthropic,openai). internal projects use only contracted providers;
# confidential projects only zero-retention ones. Free tiers (groq, google) belong in neither
# unless you hold a data-processing agreement with them. Empty = public projects only.
AURA_CONTRACTED_PROVIDERS=
AURA_ZERO_RETENTION_PROVIDERS=

# --- AURA links -----------------------------------------------------------------------------------
# apps/api URL. The VS Code bridge sends the agent's file and command calls here (ADR-4).
AURA_API_URL=http://localhost:4000
# Web app URL for the run link in a Task's pull request (Gate 6). Optional.
AURA_WEB_URL=http://localhost:5173

# --- Jira -----------------------------------------------------------------------------------------
# Jira MCP: set either a remote server (JIRA_MCP_URL + JIRA_MCP_TOKEN) or a local stdio server
# (JIRA_MCP_COMMAND + JIRA_MCP_ARGS; defaults to `uvx mcp-atlassian`) with the Jira credentials.
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
JIRA_MCP_COMMAND=
JIRA_MCP_ARGS=
JIRA_URL=
JIRA_USERNAME=
# Atlassian API token, not your account password.
JIRA_API_TOKEN=
# Required: approved Epics and Stories are filed into this project.
JIRA_PROJECT_KEY=

# --- State ----------------------------------------------------------------------------------------
# Postgres for agent memory and suspended runs (schema "mastra") and AURA drafts and ledgers
# (schema "aura_runtime"). Supabase direct connection string (session mode, port 5432).
# Required when AURA_MODE=server. Empty = local libSQL files (one developer, one process).
DATABASE_URL=

# Local drafts and ledgers store, used only when DATABASE_URL is empty.
AURA_DRAFTS_DB_URL=file:./aura-drafts.db
AURA_DRAFTS_DB_TOKEN=
