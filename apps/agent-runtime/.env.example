# Orchestrator, PO Agent, and BA Agent all run on Groq's free tier - get a key at
# https://console.groq.com/keys. Tool-calling on Groq needs the schema-compat patch in
# patches/ (applied automatically via the postinstall script).
GROQ_API_KEY=

# Jira MCP - pick ONE transport:
# 1) Remote HTTP/SSE MCP server:
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
# 2) Local stdio MCP server (defaults to `uvx mcp-atlassian` if JIRA_MCP_COMMAND is unset):
JIRA_MCP_COMMAND=
JIRA_MCP_ARGS=
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
# Required: the PO and BA agents file every Epic/Story into this project, no picker/creation flow.
JIRA_PROJECT_KEY=
# Optional: pin the exact tool names each agent gets (comma-separated), instead of the
# built-in keyword-based fallback filter. Check the "[jira-mcp] discovered tools" log line
# on startup for the exact names your server exposes.
JIRA_PO_TOOLS=
JIRA_BA_TOOLS=
