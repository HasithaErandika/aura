# Orchestrator, PO Agent, and BA Agent run on Groq's free tier - get a key at
# https://console.groq.com/keys. Tool-calling on Groq needs the schema-compat patch in
# patches/ (applied automatically via the postinstall script).
GROQ_API_KEY=

# Fallback provider: every agent below tries Groq first and fails over to Gemini's free
# tier automatically (see model-fallback.ts) if Groq errors or rate-limits. Get a free key
# from Google AI Studio (aistudio.google.com) - no billing account required.
GOOGLE_GENERATIVE_AI_API_KEY=

# Jira MCP - pick ONE transport:
# 1) Remote HTTP/SSE MCP server:
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
# 2) Local stdio MCP server (defaults to `uvx mcp-atlassian` if JIRA_MCP_COMMAND is unset):
JIRA_MCP_COMMAND=
JIRA_MCP_ARGS=
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
# Required: every Epic and Story is filed into this project after human approval.
JIRA_PROJECT_KEY=

# Draft store (drafts are referenced by id between the Orchestrator and the sub-agents).
# Defaults to a local libsql file; point at Turso for a shared deployment.
AURA_DRAFTS_DB_URL=file:./aura-drafts.db
AURA_DRAFTS_DB_TOKEN=

# Single shared root for everything AURA produces about an Epic - one folder per Epic:
# <root>/<epicKey>/architecture/ (Architect docs, Gate 3), <root>/<epicKey>/dev/<discipline>/
# (scaffolded/coded projects, Gate 4/5), <root>/<epicKey>/qa/ (test plan + Playwright source, Gate 6).
AURA_WORKSPACE_ROOT=.workspaces

# --- Coding Council (delegate_to_code provider "council", workflows/coding-council.ts) ---
# Which models each council role uses is set in code, next to every other agent's model:
# COUNCIL_*_MODEL_IDS in src/mastra/agents/registry.ts. Only the loop's limits are set here.
# Plan critique rounds (0-3), review/fix rounds (1-5), max tool steps per Implementer turn, and
# a per-run token budget that stops the council cleanly when reached.
COUNCIL_PLAN_ROUNDS=1
COUNCIL_MAX_ROUNDS=2
COUNCIL_IMPLEMENTER_STEPS=15
COUNCIL_FIX_STEPS=8
COUNCIL_TOKEN_BUDGET=150000
# Where the council's project checks (typecheck/build/test/lint) run: "host" (default, no
# Docker needed) or "docker" (inside the same sandbox Gate 4 uses - use this if AURA is ever
# hosted for other people).
SANDBOX_MODE=host
# Only needed once an anthropic/... model is added to a COUNCIL_*_MODEL_IDS list in registry.ts.
# ANTHROPIC_API_KEY=

# --- Web terminal (terminal/server.ts), under Project Files ---
# Shared secret with apps/api (same value in both .env files, 32+ random characters, e.g.
# `openssl rand -hex 32`). Unset = terminal disabled.
TERMINAL_TICKET_SECRET=
# The WebSocket server's own address. Keep it on loopback for local use.
TERMINAL_HOST=127.0.0.1
TERMINAL_PORT=4112
# full (a real shell - only allowed on a loopback TERMINAL_HOST), restricted (allowlisted
# commands only), or off. Default: full on loopback, restricted otherwise.
TERMINAL_MODE=
# Browser origins allowed to open a terminal (the web app's URL).
TERMINAL_ALLOWED_ORIGINS=http://localhost:5173
