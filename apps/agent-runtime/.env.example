# Orchestrator, PO Agent, and BA Agent run on Groq's free tier - get a key at
# https://console.groq.com/keys. Tool-calling on Groq needs the schema-compat patch in
# patches/ (applied automatically via the postinstall script).
GROQ_API_KEY=

# local (one developer's machine) or server (shared deployment). Same value as apps/api/.env.
# server refuses to start unless MASTRA_RUNTIME_TOKEN and DATABASE_URL are set.
AURA_MODE=local
# Shared secret with apps/api (same value in both .env files, 32+ random characters, e.g.
# `openssl rand -hex 32`). When set, every request must carry it as a bearer token, so only the
# API can run agents or resume gates. Required when AURA_MODE=server.
# Unset = no auth (local loopback only; keeps Mastra Studio usable, which can't send the token).
MASTRA_RUNTIME_TOKEN=

# apps/api, for the VS Code bridge (ADR-4): the vscode-agent's file and command calls go to
# POST <AURA_API_URL>/internal/bridge/calls with MASTRA_RUNTIME_TOKEN, and apps/api forwards them
# to the developer's VS Code.
AURA_API_URL=http://localhost:4000

# The AURA web app, for the run link in a Task's pull request description (Gate 6). Optional:
# without it the description names the run id only.
AURA_WEB_URL=http://localhost:5173

# Fallback provider: every agent below tries Groq first and fails over to Gemini's free
# tier automatically (see config/models.ts) if Groq errors or rate-limits. Get a free key
# from Google AI Studio (aistudio.google.com) - no billing account required.
GOOGLE_GENERATIVE_AI_API_KEY=

# Jira MCP - pick ONE transport:
# 1) Remote HTTP/SSE MCP server:
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
# 2) Local stdio MCP server (defaults to `uvx mcp-atlassian` if JIRA_MCP_COMMAND is unset):
JIRA_MCP_COMMAND=
JIRA_MCP_ARGS=
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
# Required: every Epic and Story is filed into this project after human approval.
JIRA_PROJECT_KEY=

# Postgres for agent memory, threads, suspended runs (schema "mastra") and AURA's drafts and
# ledgers (schema "aura_runtime"). Use the Supabase *direct* connection string (session mode,
# port 5432) - Project Settings → Database. Required when AURA_MODE=server. Leave empty to use
# local libSQL files (one developer, one process).
DATABASE_URL=

# Local fallback for AURA's drafts and ledgers when DATABASE_URL is empty.
AURA_DRAFTS_DB_URL=file:./aura-drafts.db
AURA_DRAFTS_DB_TOKEN=
