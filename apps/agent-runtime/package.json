    "@mastra/mcp": "^1.17.3",
    "@mastra/memory": "1.30.0",
    "@mastra/observability": "1.17.8",
    "@mastra/pg": "1.25.0",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
